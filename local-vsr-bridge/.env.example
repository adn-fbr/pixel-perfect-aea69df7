# Copy to .env and fill in. NEVER commit .env.
# Bridge HTTP server (keep 127.0.0.1 — do not expose to the network)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=4466
# Browser origins allowed to call the bridge (comma-separated, exact match)
BRIDGE_ALLOWED_ORIGINS=http://localhost:8080,https://id-preview--69cb9907-2bc3-485b-80b9-618cc7fbb040.lovable.app
# Required: configure a private token of at least 24 characters and enter it in Diagnostics.
BRIDGE_PAIRING_TOKEN=
OBS_WS_PASSWORD=replace_with_your_local_obs_websocket_password
# OBS WebSocket (OBS > Tools > WebSocket Server Settings)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=replace_with_your_local_obs_websocket_password
OBS_CONNECT_TIMEOUT_MS=5000
# Re-open the (read-only) OBS connection after an unexpected drop
OBS_AUTO_RECONNECT=true
